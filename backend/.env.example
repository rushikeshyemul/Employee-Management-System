# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-development-key-change-in-production-!@#$
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration (PostgreSQL default, falls back to SQLite if empty/unavailable in local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management_system

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# JWT Token Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_AUTH_COOKIE=wf_access
JWT_AUTH_REFRESH_COOKIE=wf_refresh

# Email Configuration (console in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
