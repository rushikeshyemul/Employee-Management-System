# Copy to .env.local for local development.
# Demo mode is ignored when NODE_ENV=production.

# demo | api
NEXT_PUBLIC_DATA_MODE=demo

# Proposed Django origin. Change this to the backend developer's base path.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# cookie | bearer
# cookie sends credentials and reads a non-HttpOnly csrftoken cookie for X-CSRFToken.
# bearer keeps access and refresh tokens in memory for the browser tab only.
NEXT_PUBLIC_AUTH_STRATEGY=cookie

# Display timezone until GET /organisation/settings/ confirms the organisation zone.
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# Server-only. Used by src/proxy.ts in API cookie mode. Must match Django's session cookie.
# AUTH_SESSION_COOKIE=wf_access
# AUTH_REFRESH_COOKIE=wf_refresh

# Optional same-origin proxy. When set, point NEXT_PUBLIC_API_BASE_URL at /api/backend
# so the browser sends cookies to this Next.js origin.
# API_PROXY_TARGET=http://localhost:8000/api/v1
